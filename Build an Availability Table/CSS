:root {
  --color0: #ebedf0;
  --color1: #9be9a8;
  --color2: #40c463;
  --color3: #30a14e;
  --color4: #216e39;
  --color5: #11421e;

  --solid-border: 2px solid #2d3748;
  --dashed-border: 2px dashed #a0aec0;
}

body {
  font-family: system-ui, -apple-system, sans-serif;
  background-color: #f7fafc;
  color: #2d3748;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  margin: 0;
  padding: 20px;
}

.container {
  background: #ffffff;
  padding: 24px;
  border-radius: 12px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  max-width: 650px;
  width: 100%;
}

table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 20px;
}

caption {
  font-size: 1.25rem;
  font-weight: 700;
  margin-bottom: 16px;
  color: #1a202c;
  text-align: left;
}

th {
  padding: 10px;
  font-size: 0.875rem;
  font-weight: 600;
}

thead th {
  background-color: #edf2f7;
  color: #4a5568;
  border-bottom: 2px solid #cbd5e0;
}

th.time {
  text-align: right;
  padding-right: 12px;
  color: #718096;
}

/* Color Variables Applied to Classes */
.available-0 {
  background-color: var(--color0);
}

.available-1 {
  background-color: var(--color1);
}

.available-2 {
  background-color: var(--color2);
}

.available-3 {
  background-color: var(--color3);
}

.available-4 {
  background-color: var(--color4);
}

.available-5 {
  background-color: var(--color5);
}

