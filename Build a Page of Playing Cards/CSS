* {
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  margin: 0;
  padding: 40px 20px;
  background-color: #173b32;
  font-family: Georgia, serif;
}

h1 {
  margin: 0 0 36px;
  color: #f8edcf;
  text-align: center;
}

#playing-cards {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20px;
}

.card {
  display: flex;
  justify-content: space-between;
  width: 180px;
  height: 260px;
  padding: 14px;
  border: 2px solid #decda6;
  border-radius: 12px;
  background-color: #fffdf6;
  box-shadow: 5px 7px 0 rgba(0, 0, 0, 0.2);
}

.left {
  align-self: flex-start;
}

.middle {
  display: flex;
  flex-direction: column;
  align-self: center;
  gap: 10px;
  font-size: 40px;
}

.right {
  align-self: flex-end;
  transform: rotate(180deg);
}

.left,
.right {
  font-size: 22px;
  font-weight: bold;
  line-height: 1;
  text-align: center;
}

.red {
  color: #bb3545;
}

.black {
  color: #202a31;
}
