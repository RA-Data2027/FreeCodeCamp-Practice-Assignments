<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Playing Cards</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <h1>Evening Card Table</h1>

  <main id="playing-cards">
    <div class="card red">
      <div class="left">A<br>♥</div>
      <div class="middle">
        <span>♥</span>
        <span>♥</span>
        <span>♥</span>
      </div>
      <div class="right">A<br>♥</div>
    </div>

    <div class="card black">
      <div class="left">K<br>♠</div>
      <div class="middle">
        <span>♠</span>
        <span>♠</span>
        <span>♠</span>
      </div>
      <div class="right">K<br>♠</div>
    </div>

    <div class="card red">
      <div class="left">Q<br>♦</div>
      <div class="middle">
        <span>♦</span>
        <span>♦</span>
        <span>♦</span>
      </div>
      <div class="right">Q<br>♦</div>
    </div>

    <div class="card black">
      <div class="left">J<br>♣</div>
      <div class="middle">
        <span>♣</span>
        <span>♣</span>
        <span>♣</span>
      </div>
      <div class="right">J<br>♣</div>
    </div>
  </main>
</body>
</html>

