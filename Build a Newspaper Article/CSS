/* 1. Sets root HTML font-size to 24px */
html {
  font-size: 24px;
}

/* Page alignment and container limits */
body {
  background-color: #f4f1ea;
  margin: 0;
  padding: 40px 20px;
  display: flex;
  justify-content: center;
}

/* 2-4. Newspaper container styling */
.newspaper {
  font-size: 16px;
  font-family: 'Open Sans', sans-serif;
  max-width: 700px;
  background-color: #ffffff;
  padding: 40px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

/* 17-19. Newspaper Title selector */
.name {
  font-size: 2rem;
  font-family: 'Times New Roman', serif;
  text-transform: uppercase;
  text-align: center;
  border-bottom: 2px solid #000000;
  padding-bottom: 5px;
}

/* Date styling */
.date {
  text-align: center;
  font-size: 0.9em;
  margin-top: 5px;
  margin-bottom: 25px;
  color: #555555;
}

/* 21-22. Headline selector */
.headline {
  font-size: 2em;
  font-weight: bold;
  margin-top: 15px;
  margin-bottom: 10px;
  line-height: 1.2;
}

/* 23-25. Sub-headline selector */
.sub-headline {
  font-weight: 100;
  font-size: 1.5em;
  font-style: italic;
  margin-top: 0;
  margin-bottom: 20px;
  color: #444444;
}

/* 20, 26. Author selector */
.author {
  font-weight: bold;
  text-transform: uppercase;
  margin-bottom: 20px;
  letter-spacing: 1px;
}

/* 27-28. Text paragraphs selector */
.text {
  text-indent: 20px;
  line-height: 2em;
  margin-bottom: 15px;
  text-align: justify;
}

/* 29-30. Drop cap effect on first letter */
.text::first-letter {
  font-weight: bold;
  font-size: 2em;
}
