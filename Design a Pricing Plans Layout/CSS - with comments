/* Base page layout setup */
body {
  font-family: Arial, sans-serif;
  background-color: #f8f9fa;
  padding: 30px;
  margin: 0;
}

h1 {
  text-align: center;
  margin-bottom: 30px;
}

/* 4-7. Flexbox container for pricing cards */
.pricing-container {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: center;
}

/* 12-17. Common styles for all pricing cards */
.pricing-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 0 0 200px;
  border: 2px solid black;
  padding: 20px;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 8px;
}

/* 18. Basic Plan ordering */
.basic-plan {
  order: 0;
}

/* 23-24. Pro Plan ordering and growth override */
.pro-plan {
  order: 1;
  flex-grow: 2;
}

/* 27. Premium Plan ordering */
.premium-plan {
  order: 2;
}
