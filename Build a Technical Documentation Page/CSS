* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: #f6f8fc;
  color: #243047;
  font-family: Arial, sans-serif;
  line-height: 1.7;
}

#navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 270px;
  height: 100vh;
  overflow-y: auto;
  background: #17243b;
  color: #ffffff;
}

#navbar header {
  padding: 30px 22px;
  font-size: 1.35rem;
  font-weight: bold;
  line-height: 1.3;
}

.nav-link {
  display: block;
  padding: 14px 22px;
  border-top: 1px solid #34435d;
  color: #dce8fa;
  text-decoration: none;
}

.nav-link:hover,
.nav-link:focus {
  background: #293f60;
  color: #ffffff;
}

#main-doc {
  max-width: 1050px;
  margin-left: 270px;
  padding: 48px 6vw 80px;
}

.main-section {
  margin-bottom: 48px;
  scroll-margin-top: 20px;
}

.main-section header {
  padding-bottom: 10px;
  border-bottom: 3px solid #45b8a7;
  color: #17243b;
  font-size: 1.8rem;
  font-weight: bold;
}

.main-section p {
  margin: 18px 0;
}

.main-section li {
  margin: 8px 0;
}

code {
  border-radius: 4px;
  background: #e8edf6;
  padding: 2px 5px;
  font-family: Consolas, Monaco, monospace;
}

pre {
  overflow-x: auto;
  border-left: 4px solid #45b8a7;
  border-radius: 6px;
  background: #e8edf6;
  padding: 18px;
}

pre code {
  padding: 0;
}

@media (max-width: 700px) {
  #navbar {
    position: relative;
    width: 100%;
    height: auto;
  }

  #navbar header {
    padding: 20px;
  }

  .nav-link {
    padding: 10px 20px;
  }

  #main-doc {
    margin-left: 0;
    padding: 28px 20px 60px;
  }

  .main-section header {
    font-size: 1.5rem;
  }
}
