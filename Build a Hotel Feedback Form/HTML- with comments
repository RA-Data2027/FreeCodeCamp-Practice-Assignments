<!DOCTYPE html>
<!-- Declares that this page uses modern HTML5 -->

<html lang="en">
  <!-- Starts the HTML document and sets English as the primary language -->

  <head>
    <!-- Contains metadata and configuration not displayed directly on the page -->

    <meta charset="UTF-8" />
    <!-- Sets character encoding to UTF-8 to display text and symbols correctly -->

    <title>Hotel Feedback Form</title>
    <!-- Text displayed in the browser tab -->
  </head>

  <body>
    <!-- Main visible content of the page -->

    <!-- Header section introducing the form's purpose -->
    <header>
      <h1>Hotel Feedback Form</h1>
      <p>
        Thank you for staying with us. Please provide feedback on your recent
        stay.
      </p>
    </header>

    <!-- Main landmark element containing the core feedback form -->
    <main>
      <!-- 
        Form container:
        - method="POST": Sends form data securely in the request body
        - action: Target endpoint URL where the data is submitted
      -->
      <form method="POST" action="https://hotel-feedback.freecodecamp.org">

        <!-- Fieldset 1: Groups personal contact inputs -->
        <fieldset>
          <legend>Personal Information</legend>

          <!-- Text input for full name (required field) -->
          <label for="full-name">Name (required):</label>
          <input type="text" id="full-name" name="name" placeholder="e.g., John Doe" required size="20">

          <!-- Email input with built-in format validation (required field) -->
          <label for="email">Email address (required):</label>
          <input
            placeholder="example@email.com"
            required
            id="email"
            type="email"
            name="email"
            size="20"
          />

          <!-- Number input with range limits (optional field) -->
          <label for="age">Age (optional):</label>
          <input type="number" name="age" id="age" min="3" max="100" />
        </fieldset>

        <!-- Fieldset 2: Radio buttons for single-choice selection -->
        <fieldset>
          <legend>Was this your first time at our hotel?</legend>

          <!-- Shared 'name' attribute ensures only one radio button can be selected at a time -->
          <input id="yes-option" type="radio" name="hotel-stay" value="yes" />
          <label for="yes-option">Yes</label>

          <input id="no-option" type="radio" name="hotel-stay" value="no" />
          <label for="no-option">No</label>
        </fieldset>

        <!-- Fieldset 3: Checkboxes for multiple-choice selections -->
        <fieldset>
          <legend>
            Why did you choose to stay at our hotel? (Check all that apply)
          </legend>

          <input type="checkbox" id="ads" name="choice" value="ads" />
          <label for="ads">Social Media Ads</label>

          <input
            type="checkbox"
            id="recommendation"
            name="choice"
            value="recommendation"
          />
          <label for="recommendation">Personal Recommendation</label>
          
          <input type="checkbox" id="location" name="choice" value="location" />
          <label for="location">Location</label>

          <!-- 'checked' attribute pre-selects this option by default -->
          <input
            checked
            type="checkbox"
            id="reputation"
            name="choice"
            value="reputation"
          />
          <label for="reputation">Reputation</label>
          
          <input type="checkbox" id="price" name="choice" value="price" />
          <label for="price">Price</label>
        </fieldset>

        <!-- Fieldset 4: Dropdown select elements for rating ratings -->
        <fieldset>
          <legend>Ratings</legend>

          <label for="service">How was the service?</label>

          <!-- Dropdown menu for service feedback -->
          <select name="service" id="service">
            <option value="poor">Poor</option>
            <option value="satisfactory">Satisfactory</option>
            <option value="good">Good</option>
            <option value="very-good">Very Good</option>

            <!-- 'selected' sets 'excellent' as the default choice -->
            <option selected value="excellent">Excellent</option>
          </select>

          <label for="food">How was the food?</label>

          <!-- Dropdown menu for food feedback -->
          <select name="food" id="food">
            <option value="poor">Poor</option>
            <option value="satisfactory">Satisfactory</option>
            <option value="good">Good</option>
            <option value="very-good">Very Good</option>
            <option selected value="excellent">Excellent</option>
          </select>
        </fieldset>

        <!-- Multi-line text input for open-ended comments -->
        <label for="comments">Other Comments?</label>
        <textarea cols="30" rows="10" name="comments" id="comments"></textarea>

      </form>
    </main>
  </body>
</html>
