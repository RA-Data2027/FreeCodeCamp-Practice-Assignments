/* Body styles: background color and font family with fallback */
body {
  background-color: rosybrown;
  font-family: Arial, sans-serif;
}

/* Business card container styles */
.business-card {
  width: 300px;
  background-color: #ffffff;
  padding: 20px;
  margin-top: 100px;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
  font-size: 16px;
}

/* Profile image responsive styling */
.profile-image {
  max-width: 100%;
}

/* Paragraph margin styling */
p {
  margin-top: 5px;
  margin-bottom: 5px;
}

/* Remove underlines from all anchor links on the page */
a {
  text-decoration: none;
}
