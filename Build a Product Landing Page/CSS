* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 110px;
}

body {
  margin: 0;
  background: #f7f7ef;
  color: #244034;
  font-family: Arial, sans-serif;
  line-height: 1.6;
}

#header {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 82px;
  padding: 12px 6%;
  background: #ffffff;
  box-shadow: 0 3px 18px rgba(36, 64, 52, 0.1);
}

.brand,
#header-img {
  display: block;
}

#header-img {
  width: 140px;
  height: auto;
}

#nav-bar {
  display: flex;
  align-items: center;
  gap: 30px;
}

.nav-link {
  color: #244034;
  font-weight: bold;
  text-decoration: none;
}

.nav-link:hover,
.nav-link:focus {
  color: #bd674c;
  text-decoration: underline;
}

main {
  padding-top: 82px;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  min-height: 540px;
  padding: 80px 9%;
  background: #dcebe0;
}

.hero-content {
  max-width: 530px;
}

.eyebrow {
  color: #ac593e;
  font-size: 0.85rem;
  font-weight: bold;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

h1,
h2,
h3 {
  line-height: 1.2;
}

h1 {
  margin: 12px 0;
  font-size: clamp(3rem, 6vw, 5.5rem);
}

h2 {
  margin: 8px 0 26px;
  font-size: clamp(2rem, 4vw, 3rem);
}

.button,
#submit {
  display: inline-block;
  border: 0;
  border-radius: 6px;
  background: #244b3b;
  color: #ffffff;
  font: inherit;
  font-weight: bold;
  text-decoration: none;
  cursor: pointer;
}

.button {
  margin-top: 20px;
  padding: 14px 22px;
}

.button:hover,
#submit:hover {
  background: #356c55;
}

.hero-art {
  position: relative;
  flex: 0 0 250px;
  height: 330px;
}

.pot {
  position: absolute;
  bottom: 0;
  left: 40px;
  width: 180px;
  height: 175px;
  border-radius: 12px 12px 38px 38px;
  background: #c47757;
  box-shadow: inset -20px 0 rgba(96, 48, 40, 0.12);
}

.stem {
  position: absolute;
  bottom: 160px;
  left: 126px;
  width: 9px;
  height: 150px;
  border-radius: 9px;
  background: #39765a;
}

.leaf {
  position: absolute;
  width: 90px;
  height: 55px;
  border-radius: 90px 10px 90px 10px;
  background: #4d916d;
}

.leaf-left {
  top: 72px;
  left: 40px;
  transform: rotate(28deg);
}

.leaf-right {
  top: 22px;
  right: 20px;
  transform: rotate(-42deg);
}

.section-block {
  max-width: 1100px;
  margin: 0 auto;
  padding: 85px 6%;
}

.feature-grid {
  display: flex;
  gap: 20px;
}

.feature-card {
  flex: 1;
  padding: 28px;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: 0 5px 24px rgba(36, 64, 52, 0.07);
}

.feature-number {
  color: #ad6046;
  font-size: 0.9rem;
  font-weight: bold;
}

.feature-card h3 {
  margin-bottom: 8px;
}

.video-section {
  text-align: center;
}

#video {
  display: block;
  width: 100%;
  max-width: 680px;
  margin: 30px auto 0;
  border-radius: 12px;
  background: #244034;
}

.signup-section {
  max-width: none;
  background: #e5ece3;
  text-align: center;
}

.signup-section form {
  max-width: 580px;
  margin: 30px auto 0;
}

.signup-section label {
  display: block;
  margin-bottom: 10px;
  font-weight: bold;
  text-align: left;
}

.form-row {
  display: flex;
  gap: 10px;
}

#email {
  flex: 1;
  min-width: 0;
  padding: 14px;
  border: 1px solid #8b9c8e;
  border-radius: 6px;
  font: inherit;
}

#submit {
  padding: 14px 20px;
}

footer {
  padding: 24px;
  text-align: center;
}

@media (max-width: 700px) {
  #header {
    flex-direction: column;
    gap: 10px;
    padding: 12px;
  }

  #nav-bar {
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px 20px;
    font-size: 0.9rem;
  }

  main {
    padding-top: 125px;
  }

  .hero {
    flex-direction: column;
    padding: 55px 7%;
    text-align: center;
  }

  .hero-art {
    flex-basis: auto;
    width: 250px;
  }

  .feature-grid,
  .form-row {
    flex-direction: column;
  }

  #submit {
    width: 100%;
  }
}
