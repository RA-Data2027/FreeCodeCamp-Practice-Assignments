<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Survey Form</title>
  </head>

  <body>
    <h1 id="title"> Coding Survey</h1>
    <p id="description">What did you enjoy about this course </p>

    <form id="survey-form">
      <label id="name-label" for="name">Name</label>
      <input
        id="name"
        name="name"
        type="text"
        placeholder="Enter your full name"
        required>

      <label
       id="email-label" for="email">Email</label>
      
      <input
          id="email"
          name="email"
          type="email"
          placeholder="Email"
          required
      >

        <label
         id="number-label"
         for ="number">Hours you can study per week</label>

         <input
          id="number"
          name="study-hours"
          type="number"
          min="1"
          max="40"
          placeholder="Enter a number from 1-40">
       
       
       <label for="dropdown">What is the most interesting topic?</label>

       <select id="dropdown" name="favorite-topic">
        <option value="html">HTML</option>
        <option value="css">CSS</option>
        <option value="javascript">JavaScript</option>
        </select>

        <fieldset>
          <legend> How would you prefer to attend classes?</legend>

          <input
            id="online"
            type="radio"
            name="attendance"
            value="online"
          > 

          <label for "online"> Online</label>
          
          <input
            id="in-person"
            type="radio"
            name="attendance"
            value="in-person"
          >
          
          <label for="in-person"> In person</label>
          </fieldset>

          <fieldset>
            <legend>Which activities would you enjoy the most? Select all that apply.</legend>

            <input
              id="practice"
              type="checkbox"
              name="activities"
              value="practice"
            >
        <label for="practice"> Hands-on Practice</label>

        <input
          id="projects"
          type="checkbox"
          name="activities"
          value="projects"
        >

        <label for="projects"> Building Projects</label> 
           
        <input
            id="discussions"
            type="checkbox"
            name="activities"
            value="projects"
           >

        <label for="discussions"> Group Discussions</label> 
      </fieldset>

  <label for="comments"> Additional Feedbacks</label> 
           
           <textarea
              id="comments"
            name="comments"
            placeholder="Please Share"></textarea>

            <button id="submit" type="submit"> Submit</button>

</form>
  </body>
</html>
